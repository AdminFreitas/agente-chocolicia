# Integração local com Ollama e a API do site. Nunca comite credenciais.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_TIMEOUT_SECONDS=180
CHOCOLICIA_API_URL=https://www.chocolicia.site
# API editorial: SITE_TOKEN_DRAFT deve ser exatamente igual a RECIPES_AGENT_TOKEN no site.
# Use o token de Preview no workflow de Preview. CRON_SECRET nunca autentica /api/articles.
CHOCOLICIA_TOKEN_DRAFT=
CHOCOLICIA_TOKEN_PUBLISH=
# Usado só pelo workflow gerar-receitas (/api/recipes/generate-daily): igual ao CRON_SECRET do site.
CRON_SECRET=
# Origem do site para scripts/gerar_receita_blog.py (opcional; padrão https://www.chocolicia.site).
CHOCOLICIA_SITE_URL=
# JSON conforme contrato do site; deve apontar para imagem licenciada/autorizada.
CHOCOLICIA_COVER_JSON=
