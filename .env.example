AGENT_ENABLED=false
AGENT_DICAS_ENABLED=false
AGENT_PHASE=0
CONTRACT_VERSION=1
TARGET=preview
DRY_RUN=true
ASSUNTO=automatico
SITE_BASE_URL=
SITE_BASE_URL_PREVIEW=
PESQUISA_PROVEDOR=mock
# Ordem de fallback entre provedores de IA em nuvem.
FALLBACK_ORDER=groq,gemini,openrouter

DATABASE_URL_AGENTE=
SITE_TOKEN_DRAFT=
SITE_TOKEN_PUBLISH=
SITE_TOKEN_DRAFT_PREVIEW=

PESQUISA_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

GEMINI_API_KEY=
GROQ_API_KEY=
