name: Arquivado - Publicar receita (Chocolícia)

# 08h em São Paulo (UTC-3; o cron do GitHub usa UTC).
# Exige runner self-hosted Windows com Ollama local e label "ollama".
on:
  schedule:
    - cron: "0 11 * * *"
  workflow_dispatch:
    inputs:
      subcategoria:
        description: Slug da subcategoria habilitada; vazio escolhe uma da taxonomia Chocolícia
        type: string
        default: ""
      assunto:
        description: Tema específico; automatico escolhe com Ollama e evita topic_slug usado
        type: string
        default: automatico
      publicar_slug:
        description: Slug de um rascunho já revisado para promover a publicado
        type: string
        default: ""

permissions:
  contents: read

concurrency:
  group: agente-chocolicia-publicar-receita
  cancel-in-progress: false

jobs:
  receita:
    if: ${{ vars.AGENT_ENABLED == 'true' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) && (github.event_name == 'schedule' || inputs.publicar_slug == '') }}
    runs-on: [self-hosted, windows, x64, ollama]
    environment: recipe-draft
    timeout-minutes: 45
    env:
      CI: "true"
      AGENT_ENABLED: ${{ vars.AGENT_ENABLED }}
      AGENT_ENV: production
      AGENT_RUN_ID: ${{ github.run_id }}-${{ github.run_attempt }}
      SITE_BASE_URL: https://www.chocolicia.site
      SITE_CONTRACT: legacy
      SITE_PHASE: ${{ vars.AGENT_PHASE || '0' }}
      SITE_TOKEN_DRAFT: ${{ secrets.RECIPES_AGENT_TOKEN_DRAFT }}
      DATABASE_URL_AGENTE: ${{ secrets.DATABASE_URL_AGENTE }}
      LLM_PROVIDER: ollama
      OLLAMA_BASE_URL: http://127.0.0.1:11434
      OLLAMA_MODEL: ${{ vars.OLLAMA_MODEL || 'qwen2.5:3b' }}
      LLM_MODEL_CREATION: ${{ vars.OLLAMA_CREATION_MODEL || vars.OLLAMA_MODEL || 'qwen2.5:3b' }}
      LLM_FAMILY_CREATION: ${{ vars.OLLAMA_CREATION_FAMILY }}
      LLM_MODEL_REVIEW: ${{ vars.OLLAMA_REVIEW_MODEL }}
      LLM_FAMILY_REVIEW: ${{ vars.OLLAMA_REVIEW_FAMILY }}
      LLM_MODEL_VISION: ${{ vars.OLLAMA_VISION_MODEL }}
      LLM_FAMILY_VISION: ${{ vars.OLLAMA_VISION_FAMILY }}
      LLM_REQUEST_TIMEOUT: "180"
      SEARCH_PROVIDER: brave
      BRAVE_SEARCH_API_KEY: ${{ secrets.PESQUISA_API_KEY }}
      PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
      PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
      PEXELS_ENABLED: "true"
      PIXABAY_ENABLED: "true"
      RECIPE_SUBCATEGORY: ${{ inputs.subcategoria || '' }}
      RECIPE_TOPIC: ${{ inputs.assunto || vars.RECIPE_TOPIC || 'automatico' }}

    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Instalar dependências
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          python -m pip install --upgrade pip
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          python -m pip install -r requirements.txt
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Gerar, validar e publicar receita
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          if ([string]::IsNullOrWhiteSpace($env:SITE_TOKEN_DRAFT)) {
            throw "Secret RECIPES_AGENT_TOKEN_DRAFT ausente."
          }
          if ([string]::IsNullOrWhiteSpace($env:DATABASE_URL_AGENTE)) {
            throw "Secret DATABASE_URL_AGENTE ausente para bloqueio de duplicatas."
          }
          if ([string]::IsNullOrWhiteSpace($env:BRAVE_SEARCH_API_KEY)) {
            throw "Secret PESQUISA_API_KEY ausente."
          }
          if ([string]::IsNullOrWhiteSpace($env:PEXELS_API_KEY) -and
              [string]::IsNullOrWhiteSpace($env:PIXABAY_API_KEY)) {
            throw "Configure pelo menos um secret de imagens: PEXELS_API_KEY ou PIXABAY_API_KEY."
          }
          foreach ($name in @("LLM_MODEL_CREATION", "LLM_FAMILY_CREATION", "LLM_MODEL_REVIEW", "LLM_FAMILY_REVIEW", "LLM_MODEL_VISION", "LLM_FAMILY_VISION")) {
            if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name))) {
              throw "Configure a variável de modelo/família Ollama: $name."
            }
          }
          if ($env:LLM_FAMILY_CREATION -eq $env:LLM_FAMILY_REVIEW) {
            throw "O modelo revisor precisa pertencer a uma família diferente do gerador."
          }
          if ($env:SITE_PHASE -notin @("1", "2", "3")) {
            throw "Defina AGENT_PHASE entre 1 e 3 para execução de produção."
          }
          $cliArgs = @(
            "rodar_agente.py", "--receita", "--enviar",
            "--target", "production", "--contrato", "legacy",
            "--fase", $env:SITE_PHASE,
            "--assunto", $env:RECIPE_TOPIC
          )
          if (-not [string]::IsNullOrWhiteSpace($env:RECIPE_SUBCATEGORY)) {
            $cliArgs += @("--subcategoria", $env:RECIPE_SUBCATEGORY)
          }
          New-Item -ItemType Directory -Force -Path output | Out-Null
          python @cliArgs | Tee-Object -FilePath output\publicacao-receita.json
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          $resultado = Get-Content output\publicacao-receita.json -Raw | ConvertFrom-Json
          if ($resultado.estado -ne "sent" -or $resultado.publicacao.status -ne "draft") {
            throw "A API não confirmou a criação do rascunho; a execução não será marcada como sucesso."
          }
          @(
            "### Rascunho criado"
            "- ID: $($resultado.publicacao.id)"
            "- Slug: $($resultado.publicacao.slug)"
            "- Status: $($resultado.publicacao.status)"
          ) | Add-Content $env:GITHUB_STEP_SUMMARY

  publicar:
    if: ${{ vars.AGENT_ENABLED == 'true' && github.event_name == 'workflow_dispatch' && inputs.publicar_slug != '' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
    runs-on: windows-latest
    environment: recipe-publish
    timeout-minutes: 10
    env:
      CI: "true"
      AGENT_ENABLED: ${{ vars.AGENT_ENABLED }}
      AGENT_ENV: production
      SITE_BASE_URL: https://www.chocolicia.site
      SITE_CONTRACT: legacy
      SITE_PHASE: ${{ vars.AGENT_PHASE || '0' }}
      SITE_TOKEN_PUBLISH: ${{ secrets.RECIPES_AGENT_TOKEN_PUBLISH }}
      AGENT_PUBLISHING_ENABLED: ${{ vars.AGENT_PUBLISHING_ENABLED || 'false' }}
      LLM_PROVIDER: ollama
      OLLAMA_BASE_URL: http://127.0.0.1:11434
      OLLAMA_MODEL: ${{ vars.OLLAMA_MODEL || 'qwen2.5:3b' }}
      LLM_MODEL_CREATION: ${{ vars.OLLAMA_CREATION_MODEL || vars.OLLAMA_MODEL || 'qwen2.5:3b' }}
      LLM_FAMILY_CREATION: ${{ vars.OLLAMA_CREATION_FAMILY }}
      LLM_MODEL_REVIEW: ${{ vars.OLLAMA_REVIEW_MODEL }}
      LLM_FAMILY_REVIEW: ${{ vars.OLLAMA_REVIEW_FAMILY }}
      LLM_MODEL_VISION: ${{ vars.OLLAMA_VISION_MODEL }}
      LLM_FAMILY_VISION: ${{ vars.OLLAMA_VISION_FAMILY }}
      SEARCH_PROVIDER: brave
      BRAVE_SEARCH_API_KEY: ${{ secrets.PESQUISA_API_KEY }}
      RECIPE_SLUG: ${{ inputs.publicar_slug }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Instalar dependências
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          python -m pip install -r requirements.txt
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Publicar rascunho revisado
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          if ($env:SITE_PHASE -notin @("1", "2", "3")) {
            throw "Defina AGENT_PHASE entre 1 e 3 para publicação."
          }
          if ([string]::IsNullOrWhiteSpace($env:SITE_TOKEN_PUBLISH)) {
            throw "Secret RECIPES_AGENT_TOKEN_PUBLISH ausente no ambiente recipe-publish."
          }
          if ($env:AGENT_PUBLISHING_ENABLED -ne "true") {
            throw "A publicação está bloqueada no site; habilite o interruptor após aprovação."
          }
          if ($env:RECIPE_SLUG -notmatch '^[a-z0-9]+(?:-[a-z0-9]+)*$') {
            throw "Slug de rascunho inválido."
          }
          python rodar_agente.py --publicar-slug $env:RECIPE_SLUG --enviar --target production
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
